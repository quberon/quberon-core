{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quberon.example.invalid/schemas/humanoids/1.0.0/company.schema.json",
  "title": "Humanoid company candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "record_kind",
    "candidate_names",
    "aliases",
    "canonical_name",
    "verification",
    "entity_scope",
    "provenance_claim_ids",
    "sources",
    "review"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^cand-[a-z0-9-]+$"
    },
    "record_kind": {
      "const": "humanoid_company_candidate"
    },
    "candidate_names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "uniqueItems": true
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "uniqueItems": true
    },
    "canonical_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis",
        "reviewed_by",
        "reviewed_at",
        "evidence_source_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate_unverified",
            "partially_verified",
            "verified",
            "rejected",
            "duplicate",
            "out_of_scope"
          ]
        },
        "basis": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^src-[a-z0-9-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "entity_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "humanoid_relevance",
        "scope_basis"
      ],
      "properties": {
        "humanoid_relevance": {
          "enum": [
            "unknown",
            "claimed_humanoid",
            "claimed_humanoid_adjacent",
            "confirmed_out_of_scope"
          ]
        },
        "scope_basis": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    },
    "provenance_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^claim-[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^src-[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "products_claimed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "provenance_claim_ids"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 300
          },
          "status": {
            "enum": [
              "candidate_unverified",
              "partially_verified",
              "verified",
              "rejected"
            ]
          },
          "provenance_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^claim-[a-z0-9-]+$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target_record_id",
          "status"
        ],
        "properties": {
          "type": {
            "enum": [
              "parent",
              "subsidiary",
              "lab",
              "brand",
              "spinout",
              "partner",
              "unknown"
            ]
          },
          "target_record_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "candidate_unverified",
              "partially_verified",
              "verified",
              "rejected"
            ]
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_action",
        "priority"
      ],
      "properties": {
        "next_action": {
          "enum": [
            "find_official_site",
            "verify_legal_entity",
            "check_duplicate",
            "assess_scope",
            "await_human_review"
          ]
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    }
  },
  "$defs": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis",
        "reviewed_by",
        "reviewed_at",
        "evidence_source_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate_unverified",
            "partially_verified",
            "verified",
            "rejected",
            "duplicate",
            "out_of_scope"
          ]
        },
        "basis": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^src-[a-z0-9-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "url_or_null": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "maxLength": 2048
    },
    "iso_date_or_null": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  }
}

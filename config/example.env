# Copy to /etc/quberon-robot-interface/app.env on the Pi; never commit real values.
ROBOT_ID=quberon-demo-001
QUBERON_DB_PATH=/var/lib/quberon-robot-interface/quberon.db
ALLOWED_HOSTS=localhost,127.0.0.1,10.77.0.2,10.99.0.1,quberon-pi.local
META_MODE=mock
# META_API_URL=
# META_MODEL=
# META_API_KEY is referenced from a separate root/service-readable secret mechanism; do not put phone-visible values in QR codes.
DEMO_INSECURE_HTTP=false
